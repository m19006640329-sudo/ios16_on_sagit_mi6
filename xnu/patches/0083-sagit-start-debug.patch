+	b.lo	1b
+	lsr	x0, x8, #24
+	and	w0, w0, #0xffffff
+	orr	w0, w0, #0xff000000
+	add	x4, x4, x9
+2:	str	w0, [x1], #4
+	cmp	x1, x4
+	b.lo	2b
+	lsr	x0, x8, #48
+	and	w0, w0, #0xffff
+	orr	w0, w0, #0xff000000
+	add	x4, x4, x9
+3:	str	w0, [x1], #4
